{
  "expo": {
    "name": "GoNorth",
    "slug": "gonorth",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.gonorth.app"
    },
    "android": {
      "package": "com.gonorth.app",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyBn8VW9EcLybbFyIzMyiMHjUtWeB66dgxg"
        }
      },
      "adaptiveIcon": {
        "backgroundColor": "#1A73E8",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      "expo-localization",
      "expo-secure-store",
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.gonorth.app"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "GoNorth needs access to your photos for KYC and profile pictures."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "GoNorth uses your location to find nearby trips."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#1A73E8"
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "eas": {
        "projectId": "2b8eadc5-35d7-463d-b059-fd532e57feed"
      }
    },
    "owner": "eyosiasdesta"
  }
}
